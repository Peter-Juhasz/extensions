<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup>
		<VersionPrefix>2.0.0</VersionPrefix>
		<PackageId>PeterJuhasz.Extensions</PackageId>
		<PackageTags>extensions</PackageTags>
		<PackageProjectUrl>https://github.com/Peter-Juhasz/extensions</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Peter-Juhasz/extensions</RepositoryUrl>
	</PropertyGroup>
	
	<PropertyGroup>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<InvariantGlobalization>true</InvariantGlobalization>
		<EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
		<EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
		<WarningsNotAsErrors>IL2026</WarningsNotAsErrors>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration) == 'Release'">
		<TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
		<PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.*" />
		<PackageReference Include="System.Memory.Data" Version="10.*" />
		<PackageReference Include="Microsoft.Extensions.Primitives" Version="10.*" />
	</ItemGroup>

	<!-- PublicApiAnalyzers is only active inside the dotnet format run of the GeneratePublicApi target, which sets _GeneratingPublicApi -->
	<PropertyGroup>
		<_PublicApiDir>$(BaseIntermediateOutputPath)PublicApi\</_PublicApiDir>
	</PropertyGroup>
	<ItemGroup Condition="'$(_GeneratingPublicApi)' == 'true'">
		<AdditionalFiles Include="$(_PublicApiDir)PublicAPI.Shipped.txt" />
		<AdditionalFiles Include="$(_PublicApiDir)PublicAPI.Unshipped.txt" />
	</ItemGroup>
	<Target Name="RemovePublicApiAnalyzer" BeforeTargets="CoreCompile" Condition="'$(_GeneratingPublicApi)' != 'true'">
		<ItemGroup>
			<Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Microsoft.CodeAnalysis.PublicApiAnalyzers'" />
		</ItemGroup>
	</Target>

	<!-- Generates PublicAPI.Shipped.txt from scratch using the RS0016 code fix of PublicApiAnalyzers and packs it, opt-in with -p:GeneratePublicApi=true -->
	<Target Name="GeneratePublicApi" AfterTargets="Build" Condition="'$(GeneratePublicApi)' == 'true' and '$(DesignTimeBuild)' != 'true'">
		<PropertyGroup>
			<_DotNetHost>$(DOTNET_HOST_PATH)</_DotNetHost>
			<_DotNetHost Condition="'$(_DotNetHost)' == ''">dotnet</_DotNetHost>
		</PropertyGroup>

		<!-- the code fix only adds entries to the unshipped file, so start both from empty -->
		<WriteLinesToFile File="$(_PublicApiDir)PublicAPI.Shipped.txt" Lines="#nullable enable" Overwrite="true" />
		<WriteLinesToFile File="$(_PublicApiDir)PublicAPI.Unshipped.txt" Lines="#nullable enable" Overwrite="true" />
		<!-- environment variables become MSBuild properties in the project loaded by dotnet format -->
		<Exec Command="&quot;$(_DotNetHost)&quot; format analyzers &quot;$(MSBuildProjectFullPath)&quot; --diagnostics RS0016 --severity info --no-restore" EnvironmentVariables="_GeneratingPublicApi=true" />

		<ReadLinesFromFile File="$(_PublicApiDir)PublicAPI.Unshipped.txt">
			<Output TaskParameter="Lines" ItemName="_PublicApiLine" />
		</ReadLinesFromFile>
		<WriteLinesToFile File="$(_PublicApiDir)PublicAPI.Shipped.txt" Lines="@(_PublicApiLine)" Overwrite="true" />
		<Delete Files="$(_PublicApiDir)PublicAPI.Unshipped.txt" />

		<ItemGroup>
			<None Include="$(_PublicApiDir)PublicAPI.Shipped.txt" Pack="true" PackagePath="\" />
		</ItemGroup>
	</Target>

</Project>
